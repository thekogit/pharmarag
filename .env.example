# Generator LLM: any OpenAI-compatible endpoint. Default: Ollama Cloud.
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=your-ollama-cloud-api-key
LLM_MODEL=beam:cloud

# Local Ollama: serves bge-m3 embeddings and the Prometheus-2 judge
OLLAMA_HOST=http://127.0.0.1:11434
EMBED_MODEL=bge-m3
JUDGE_MODEL=hf.co/mradermacher/prometheus-7b-v2.0-GGUF:Q5_K_M

# Vector store: embedded Qdrant at QDRANT_PATH, or a server if QDRANT_URL is set
QDRANT_PATH=./qdrant_storage
# QDRANT_URL=http://localhost:6333
COLLECTION_NAME=fda_labels

# Cross-encoders (downloaded from Hugging Face on first use, run on CPU)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-base

# Pipeline switches (1/0) for ablations: retrieval mode is dense | sparse | hybrid
RETRIEVAL_MODE=hybrid
RERANK=1
FRESHNESS=1
GATES=1
GROUNDING=1
